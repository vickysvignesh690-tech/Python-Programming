BT 1 0 0 1 4 210.8 Tm /F4 7.7 Tf 9.5 TL (def subsidy_buggy\(units, ration, senior80\):) Tj T* (    result = []) Tj T* (    if units <= 100:) Tj T* (        result.append\("full"\)) Tj T* (    if units <= 200 and ration:            # no lower bound -> overlaps with the first rule) Tj T* (        result.append\("partial"\)) Tj T* (    if units > 200 and senior80:) Tj T* (        result.append\("senior"\)) Tj T* (    return result or ["none"]) Tj T*  T* (def subsidy\(units, ration, senior80\):) Tj T* (    if units <= 100:) Tj T* (        return "full") Tj T* (    elif 101 <= units <= 200:              # chained comparison) Tj T* (        return "partial" if ration else "none") Tj T* (    else:                                  # units > 200) Tj T* (        return "senior" if senior80 else "none") Tj T*  T* (cases = [\(100, True, False\), \(100, False, False\), \(101, True, False\), \(101, False, False\),) Tj T* (         \(200, True, False\), \(200, False, False\), \(201, False, True\), \(201, False, False\)]) Tj T* (print\(f"{'units':>5} {'ration':>6} {'age80':>5}   {'separate ifs':<16} if-elif-else"\)) Tj T* (for u, r, s in cases:) Tj T* (    print\(f"{u:>5} {str\(r\):>6} {str\(s\):>5}   {str\(subsidy_buggy\(u, r, s\)\):<16} {subsidy\(u, r, s\)}"\)) Tj T* ET
