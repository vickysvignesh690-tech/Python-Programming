BT 1 0 0 1 4 638.3 Tm /F4 7.7 Tf 9.5 TL (CORRECT = "4821") Tj T*  T* (def otp_while\(read=input\):) Tj T* (    attempts = 0) Tj T* (    while attempts < 3:) Tj T* (        entry = read\("OTP: "\).strip\(\)) Tj T* (        if entry == "":) Tj T* (            continue                       # blank entry: skip, counter NOT updated) Tj T* (        attempts += 1                      # counter updated after the blank check) Tj T* (        if entry == CORRECT:) Tj T* (            print\("Verified"\)) Tj T* (            break                          # success: leave loop, skip the else) Tj T* (        print\("Wrong,", 3 - attempts, "attempt\(s\) left"\)) Tj T* (    else:                                  # runs only when the loop ended without break) Tj T* (        print\("Account locked for 30 minutes"\)) Tj T*  T* (def otp_for\(read=input\):) Tj T* (    for attempt in range\(3\):) Tj T* (        entry = "") Tj T* (        while entry == "":                 # re-prompt on blank so it does not burn an attempt) Tj T* (            entry = read\("OTP: "\).strip\(\)) Tj T* (        if entry == CORRECT:) Tj T* (            print\("Verified"\)) Tj T* (            break) Tj T* (        print\("Wrong"\)) Tj T* (    else:) Tj T* (        print\("Account locked for 30 minutes"\)) Tj T*  T* (def otp_with_bonus\(read=input, security_ok=lambda: True\):) Tj T* (    allowed, attempts, bonus_given = 3, 0, False) Tj T* (    while attempts < allowed:) Tj T* (        entry = read\("OTP: "\).strip\(\)) Tj T* (        if entry == "":) Tj T* (            pass                           # pass = placeholder/no-op \(a real handler could log it\)) Tj T* (            continue) Tj T* (        attempts += 1) Tj T* (        if entry == CORRECT:) Tj T* (            print\("Verified"\)) Tj T* (            break) Tj T* (        print\("Wrong"\)) Tj T* (        if attempts == allowed and not bonus_given and security_ok\(\):) Tj T* (            allowed += 2                   # changed condition: two extra attempts, once only) Tj T* (            bonus_given = True) Tj T* (            print\("Security answer correct: 2 extra attempts"\)) Tj T* (    else:) Tj T* (        print\("Account locked for 30 minutes"\)) Tj T*  T* (def otp_recursive\(left=3, read=input\):) Tj T* (    if left == 0:) Tj T* (        print\("Account locked for 30 minutes"\)) Tj T* (        return False) Tj T* (    entry = read\("OTP: "\).strip\(\)) Tj T* (    if entry == "":) Tj T* (        return otp_recursive\(left, read\)   # blank: same attempts left) Tj T* (    if entry == CORRECT:) Tj T* (        print\("Verified"\)) Tj T* (        return True) Tj T* (    return otp_recursive\(left - 1, read\)) Tj T*  T* (def scripted\(*answers\):                    # feeds scripted keyboard input for the demonstration) Tj T* (    it = iter\(answers\)) Tj T* (    return lambda prompt="": next\(it\)) Tj T*  T* (print\("while, blank then wrong x3:"\); otp_while\(scripted\("", "1", "2", "3"\)\)) Tj T* (print\("for,   wrong then correct :"\); otp_for\(scripted\("9", "4821"\)\)) Tj T* (print\("for,   blank + wrong x3   :"\); otp_for\(scripted\("", "1", "2", "3"\)\)) Tj T* (print\("bonus, 3 wrong + security then 4821:"\); otp_with_bonus\(scripted\("1", "2", "3", "4821"\)\)) Tj T* (print\("recursive, wrong x3       :"\); otp_recursive\(read=scripted\("1", "2", "3"\)\)) Tj T* ET
Q
 

