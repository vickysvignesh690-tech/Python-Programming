BT 1 0 0 1 4 258.3 Tm /F4 7.7 Tf 9.5 TL (def bill\(price, qty=1, *, gst_rate=0.05\):) Tj T* (    total = price * qty) Tj T* (    gst = round\(total * gst_rate, 2\)) Tj T* (    return total, gst                     # a tuple, unpacked by the caller) Tj T*  T* (total, gst = bill\(40, 2\)) Tj T* (print\("total =", total, "gst =", gst, "| with 12%:", bill\(40, 2, gst_rate=0.12\)\)) Tj T*  T* (x = "global") Tj T* (def read_only\(\):) Tj T* (    return x                              # reads the global name) Tj T* (def local_demo\(\):) Tj T* (    x = "local"                           # creates a NEW local name; the global is untouched) Tj T* (    return x) Tj T* (def global_demo\(\):) Tj T* (    global x) Tj T* (    x = "changed"                         # without 'global' this would create a local instead) Tj T* (def make_counter\(\):) Tj T* (    n = 0) Tj T* (    def inc\(\):) Tj T* (        nonlocal n                        # rebinds n in the enclosing function) Tj T* (        n += 1) Tj T* (        return n) Tj T* (    return inc) Tj T*  T* (print\(read_only\(\), local_demo\(\), x\)       # global local global) Tj T* (global_demo\(\); print\(x\)                   # changed) Tj T* (counter = make_counter\(\); counter\(\); print\(counter\(\)\)   # 2) Tj T* ET
